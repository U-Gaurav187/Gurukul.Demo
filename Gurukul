<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gurukul Institute | Center for Academic Excellence</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-900 antialiased" x-data="{ mobileMenuOpen: false }">

    <div class="bg-indigo-950 text-amber-400 text-xs md:text-sm py-2 px-4 text-center font-semibold tracking-wide shadow-inner">
        ✨ Admissions Open for Academic Session 2026-27. 
        <a href="#contact" class="underline underline-offset-4 hover:text-amber-300 transition-colors ml-1">Apply Online Now →</a>
    </div>

    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-11 h-11 bg-gradient-to-br from-indigo-600 to-violet-600 rounded-xl flex items-center justify-center text-white font-extrabold text-xl shadow-md shadow-indigo-200 group-hover:scale-105 transition-transform">
                    G
                </div>
                <div class="flex flex-col">
                    <span class="text-xl font-extrabold tracking-tight text-indigo-950 leading-none">GURUKUL</span>
                    <span class="text-[10px] text-indigo-600 font-bold tracking-widest mt-1 uppercase">Institute</span>
                </div>
            </a>

            <nav class="hidden md:flex items-center gap-8 font-semibold text-sm text-slate-600">
                <a href="#" class="text-indigo-600 transition-colors">Home</a>
                <a href="#about" class="hover:text-indigo-600 transition-colors">About</a>
                <a href="#courses" class="hover:text-indigo-600 transition-colors">Programs</a>
                <a href="#features" class="hover:text-indigo-600 transition-colors">Why Us</a>
                <a href="#faq" class="hover:text-indigo-600 transition-colors">FAQs</a>
            </nav>

            <div class="hidden md:flex items-center gap-4">
                <a href="#contact" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold px-6 py-3 rounded-xl shadow-lg shadow-indigo-200 transition-all hover:-translate-y-0.5">
                    Enroll Now
                </a>
            </div>

            <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden p-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-show="!mobileMenuOpen">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-show="mobileMenuOpen" style="display: none;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <div x-show="mobileMenuOpen" 
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-4"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 -translate-y-4"
             class="absolute top-full left-0 w-full bg-white border-b border-slate-200 shadow-xl px-4 py-6 flex flex-col gap-3 md:hidden" 
             style="display: none;">
            <a href="#" @click="mobileMenuOpen = false" class="text-indigo-600 font-bold py-2.5 px-3 rounded-xl bg-indigo-50">Home</a>
            <a href="#about" @click="mobileMenuOpen = false" class="text-slate-700 font-semibold py-2.5 px-3 rounded-xl hover:bg-slate-50">About Us</a>
            <a href="#courses" @click="mobileMenuOpen = false" class="text-slate-700 font-semibold py-2.5 px-3 rounded-xl hover:bg-slate-50">Programs</a>
            <a href="#features" @click="mobileMenuOpen = false" class="text-slate-700 font-semibold py-2.5 px-3 rounded-xl hover:bg-slate-50">Why Gurukul</a>
            <a href="#faq" @click="mobileMenuOpen = false" class="text-slate-700 font-semibold py-2.5 px-3 rounded-xl hover:bg-slate-50">FAQs</a>
            <div class="pt-4 border-t border-slate-100">
                <a href="#contact" @click="mobileMenuOpen = false" class="block w-full bg-indigo-600 text-white text-center font-bold py-3.5 rounded-xl shadow-lg shadow-indigo-100">
                    Enroll Online
                </a>
            </div>
        </div>
    </header>

    <section class="relative overflow-hidden pt-8 pb-20 lg:pt-20 lg:pb-32 bg-gradient-to-b from-indigo-50/60 via-white to-slate-50">
        <div class="absolute top-0 right-0 -mr-40 w-[500px] h-[500px] bg-indigo-200/40 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -ml-40 w-[400px] h-[400px] bg-amber-100/30 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                    <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-indigo-100 text-indigo-800 tracking-wider uppercase">
                        🚀 Premier Academic Training Center
                    </span>
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-indigo-950 leading-[1.15]">
                        Empowering Minds, <br class="hidden sm:inline">
                        <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">Engineering Success</span>
                    </h1>
                    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 font-medium leading-relaxed">
                        Gurukul Institute offers structural, metric-driven classroom training designed to unlock deep academic competence and help you clear competitive streams with absolute confidence.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
                        <a href="#courses" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-4 rounded-xl shadow-xl shadow-indigo-200 transition-all hover:-translate-y-0.5 text-center">
                            Explore Programs
                        </a>
                        <a href="#contact" class="bg-white hover:bg-slate-50 text-slate-800 font-bold px-8 py-4 rounded-xl shadow-md border border-slate-200 transition-all hover:-translate-y-0.5 text-center">
                            Book Free Counselling
                        </a>
                    </div>
                </div>

                <div class="lg:col-span-5 relative">
                    <div class="relative mx-auto max-w-[440px] lg:max-w-none">
                        <div class="absolute inset-0 bg-gradient-to-tr from-indigo-600 to-amber-400 rounded-3xl rotate-3 scale-102 opacity-10 blur-sm"></div>
                        <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&q=80&w=800" 
                             alt="Students Collaborating at Gurukul" 
                             class="rounded-3xl shadow-2xl border-4 border-white relative z-10 object-cover aspect-[4/3] sm:aspect-square lg:aspect-[4/5] w-full" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-indigo-950 text-white py-12 relative z-20 shadow-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 text-center divide-y md:divide-y-0 md:divide-x divide-indigo-800/60">
                <div class="pt-2 md:pt-0">
                    <div class="text-3xl lg:text-4xl font-extrabold text-amber-400">15K+</div>
                    <div class="text-xs lg:text-sm text-indigo-200 font-semibold uppercase tracking-wider mt-1">Success Stories</div>
                </div>
                <div class="pt-6 md:pt-0">
                    <div class="text-3xl lg:text-4xl font-extrabold text-amber-400">98.4%</div>
                    <div class="text-xs lg:text-sm text-indigo-200 font-semibold uppercase tracking-wider mt-1">Selection Rate</div>
                </div>
                <div class="pt-6 md:pt-0">
                    <div class="text-3xl lg:text-4xl font-extrabold text-amber-400">45+</div>
                    <div class="text-xs lg:text-sm text-indigo-200 font-semibold uppercase tracking-wider mt-1">Expert Mentors</div>
                </div>
                <div class="pt-6 md:pt-0">
                    <div class="text-3xl lg:text-4xl font-extrabold text-amber-400">100%</div>
                    <div class="text-xs lg:text-sm text-indigo-200 font-semibold uppercase tracking-wider mt-1">Personal Focus</div>
                </div>
            </div>
        </div>
    </section>

    <section id="courses" class="py-24 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
                <span class="text-xs font-bold text-indigo-600 tracking-widest uppercase">Structured Learning Tracks</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-indigo-950 tracking-tight">Our Flagship Educational Programs</h2>
                <p class="text-slate-600 font-medium">Curriculums systematically optimized for competitive accuracy and deep concept clarity.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white rounded-2xl border border-slate-200/60 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col group">
                    <div class="overflow-hidden relative h-52 bg-slate-100">
                        <img src="https://images.unsplash.com/photo-1606326608606-aa0b62935f2b?auto=format&fit=crop&q=80&w=600" alt="JEE Classroom" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <span class="absolute top-4 left-4 bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-md shadow-md">Engineering</span>
                    </div>
                    <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
                        <div>
                            <h3 class="text-xl font-bold text-indigo-950">IIT-JEE Track (Main & Advanced)</h3>
                            <p class="text-slate-600 text-sm font-medium mt-2 leading-relaxed">Advanced mathematical problem matrices, kinetic chemistry mechanisms, and rigorous multi-tier physical analysis formulas.</p>
                        </div>
                        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="font-bold text-slate-400 uppercase tracking-wider">Class 11, 12 & Droppers</span>
                            <a href="#contact" class="text-indigo-600 font-bold hover:text-indigo-800 flex items-center gap-1">Details →</a>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/60 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col group">
                    <div class="overflow-hidden relative h-52 bg-slate-100">
                        <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&q=80&w=600" alt="NEET Lab" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <span class="absolute top-4 left-4 bg-emerald-600 text-white text-xs font-bold px-3 py-1 rounded-md shadow-md">Medical</span>
                    </div>
                    <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
                        <div>
                            <h3 class="text-xl font-bold text-indigo-950">NEET Target Program</h3>
                            <p class="text-slate-600 text-sm font-medium mt-2 leading-relaxed">In-depth structural breakdown of organic transformations, molecular biological pathways, and applied systemic medical diagnostics.</p>
                        </div>
                        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="font-bold text-slate-400 uppercase tracking-wider">Comprehensive 1/2 Year</span>
                            <a href="#contact" class="text-indigo-600 font-bold hover:text-indigo-800 flex items-center gap-1">Details →</a>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/60 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col group">
                    <div class="overflow-hidden relative h-52 bg-slate-100">
                        <img src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&q=80&w=600" alt="Olympiad Prep" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <span class="absolute top-4 left-4 bg-amber-600 text-white text-xs font-bold px-3 py-1 rounded-md shadow-md">Foundations</span>
                    </div>
                    <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
                        <div>
                            <h3 class="text-xl font-bold text-indigo-950">Early Olympiads & NTSE</h3>
                            <p class="text-slate-600 text-sm font-medium mt-2 leading-relaxed">Developing early rotational mechanics insight, clear analytical frameworks, and logic matrices for secondary level scholarships.</p>
                        </div>
                        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="font-bold text-slate-400 uppercase tracking-wider">Class 8 to 10 Early Track</span>
                            <a href="#contact" class="text-indigo-600 font-bold hover:text-indigo-800 flex items-center gap-1">Details →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="faq" class="py-24 bg-white" x-data="{ activeAccordion: null }">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-16 space-y-3">
                <h2 class="text-3xl font-extrabold text-indigo-950 tracking-tight">Frequently Asked Questions</h2>
                <p class="text-slate-600 font-medium">Everything you need to verify concerning intake criteria and performance support.</p>
            </div>

            <div class="space-y-4">
                <div class="bg-slate-50 rounded-xl border border-slate-200/60 overflow-hidden transition-all">
                    <button @click="activeAccordion = (activeAccordion === 1 ? null : 1)" class="w-full text-left px-6 py-5 font-bold text-indigo-950 flex justify-between items-center hover:bg-slate-100/50 transition-colors">
                        <span class="text-sm sm:text-base">What is the selection roadmap for high-tier batches?</span>
                        <span class="text-xl text-slate-400 font-light transition-transform duration-200" :class="activeAccordion === 1 ? 'rotate-45 text-indigo-600' : ''">+</span>
                    </button>
                    <div class="px-6 pb-5 text-sm text-slate-600 font-medium leading-relaxed" x-show="activeAccordion === 1" style="display: none;">
                        Batches are segmented based on a diagnostic evaluation test. This helps our team identify your current logical baselines and core mechanistic speed rather than simply checking memorized layouts.
                    </div>
                </div>

                <div class="bg-slate-50 rounded-xl border border-slate-200/60 overflow-hidden transition-all">
                    <button @click="activeAccordion = (activeAccordion === 2 ? null : 2)" class="w-full text-left px-6 py-5 font-bold text-indigo-950 flex justify-between items-center hover:bg-slate-100/50 transition-colors">
                        <span class="text-sm sm:text-base">Are backup recorded streams provided if a session is missed?</span>
                        <span class="text-xl text-slate-400 font-light transition-transform duration-200" :class="activeAccordion === 2 ? 'rotate-45 text-indigo-600' : ''">+</span>
                    </button>
                    <div class="px-6 pb-5 text-sm text-slate-600 font-medium leading-relaxed" x-show="activeAccordion === 2" style="display: none;">
                        Yes, every high-tier conceptual lecture is systematically archived into an internal digital storage portal, backed by dedicated live doubt clearing desks active every evening.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" class="py-20 bg-slate-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 bg-indigo-950 rounded-3xl overflow-hidden shadow-2xl relative">
                
                <div class="p-8 sm:p-12 lg:col-span-5 text-white flex flex-col justify-between space-y-12">
                    <div class="space-y-4">
                        <h2 class="text-3xl font-extrabold tracking-tight text-white">Connect with Our Admissions Desk</h2>
                        <p class="text-indigo-200 text-sm font-medium leading-relaxed">
                            Have specific program scheduling or structural batch inquiries? Drop your info and an executive counselor will verify your parameters within 24 hours.
                        </p>
                    </div>
                    <div class="space-y-4 text-sm font-medium text-indigo-100">
                        <div class="flex items-start gap-3">
                            <span class="text-amber-400 mt-0.5">📍</span>
                            <span>Corporate Campus, Vikhroli, Mumbai, Maharashtra, India</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-amber-400">📞</span>
                            <span>+91 22 5557 9100</span>
                        </div>
                    </div>
                </div>

                <div class="p-8 sm:p-12 lg:col-span-5 text-white flex flex-col justify-between space-y-12">
                    <div class="space-y-4">
                        <h2 class="text-3xl font-extrabold tracking-tight text-white">Connect with Our Admissions Desk</h2>
                        <p class="text-indigo-200 text-sm font-medium leading-relaxed">
                            Have specific program scheduling or structural batch inquiries? Drop your info and an executive counselor will verify your parameters within 24 hours.
                        </p>
                    </div>
                    <div class="space-y-4 text-sm font-medium text-indigo-100">
                        <div class="flex items-start gap-3">
                            <span class="text-amber-400 mt-0.5">📍</span>
                            <span>Corporate Campus, Vikhroli, Mumbai, Maharashtra, India</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-amber-400">📞</span>
                            <span>+91 22 5557 9100</span>
                        </div>
                    </div>
                </div>

                <div class="p-8 sm:p-12 lg:col-span-7 bg-white/5 backdrop-blur-sm border-t lg:border-t-0 lg:border-l border-white/10">
                    <form class="space-y-5" onsubmit="event.preventDefault(); alert('Inquiry successfully logged! Our counseling guidance desk will reach out shortly.');">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="space-y-2">
                                <label class="text-xs font-bold uppercase tracking-wider text-indigo-200">Full Name</label>
                                <input type="text" required placeholder="Gaurav" class="w-full bg-white/10 text-white rounded-xl px-4 py-3.5 border border-white/20 focus:outline-none focus:border-amber-400 placeholder-white/30 transition-colors text-sm font-medium">
                            </div>
                            <div class="space-y-2">
                                <label class="text-xs font-bold uppercase tracking-wider text-indigo-200">Contact Number</label>
                                <input type="tel" required placeholder="+91 98765 43210" class="w-full bg-white/10 text-white rounded-xl px-4 py-3.5 border border-white/20 focus:outline-none focus:border-amber-400 placeholder-white/30 transition-colors text-sm font-medium">
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-indigo-200">Target Learning Stream</label>
                            <select class="w-full bg-indigo-900 text-white rounded-xl px-4 py-3.5 border border-white/20 focus:outline-none focus:border-amber-400 transition-colors text-sm font-medium">
                                <option class="bg-indigo-950">IIT-JEE (Engineering Track)</option>
                                <option class="bg-indigo-950">NEET (Medical Track)</option>
                                <option class="bg-indigo-950">Foundational Target (Class 8-10)</option>
                            </select>
                        </div>
                        <button type="submit" class="w-full bg-amber-400 hover:bg-amber-500 text-indigo-950 font-extrabold py-4 rounded-xl shadow-xl shadow-amber-500/10 transition-colors cursor-pointer text-sm tracking-wide uppercase">
                            Submit Registration Inquiry
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </section>

    <footer class="bg-slate-900 text-slate-400 text-xs py-10 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-2">
                <div class="w-7 h-7 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-xs">G</div>
                <span class="font-bold tracking-wider text-white">GURUKUL INSTITUTE</span>
            </div>
            <p class="text-slate-500 text-center md:text-right">
                © 2026 Gurukul Institute. All rights reserved. Built with structural fluid semantic layouts.
            </p>
        </div>
    </footer>

</body>
</html>
